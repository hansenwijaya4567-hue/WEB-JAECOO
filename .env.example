# Salin file ini menjadi .env.local lalu isi dengan nilai asli.
# .env.local sudah otomatis di-ignore oleh git, jadi aman untuk kredensial.

# ---------------------------------------------------------------------------
# Analytics (opsional - kosongkan berarti script tidak dimuat sama sekali)
# ---------------------------------------------------------------------------

# Google Analytics 4 Measurement ID.
# Sumber: GA4 Admin > Property > Data Streams > Web > Measurement ID
# Contoh: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID.
# Sumber: Meta Events Manager > Data Sources > Pixel > Settings
# Contoh: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Lead storage (opsional)
# ---------------------------------------------------------------------------

# Google Apps Script Web App URL untuk menyimpan lead ke Google Sheets.
# Nilai ini MENIMPA `sheetsWebhookUrl` yang ada di src/data/config.ts.
# Cara membuat: Extensions > Apps Script > Deploy > New deployment > Web app
#   Execute as: Me
#   Who has access: Anyone
# Petunjuk lengkap ada di README.md bagian 4.
# Contoh: https://script.google.com/macros/s/AKfycbXXXXXXXX/exec
GOOGLE_SHEETS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Catatan
# ---------------------------------------------------------------------------
# - Semua variabel NEXT_PUBLIC_* di-inline ke bundle saat build, jadi nilainya
#   akan terlihat publik. Jangan pernah menaruh secret di sini.
# - Setelah mengubah .env.local, restart `npm run dev` karena Next.js hanya
#   membaca environment variable saat server start.
# - Untuk production, atur variabel yang sama di dashboard hosting
#   (Vercel > Settings > Environment Variables), bukan di file .env.